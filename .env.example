# --- LLM (pick one or both) ---
GEMINI_API_KEY=            # get free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://host.docker.internal:11434   # local: http://localhost:11434 ; run `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2
DEFAULT_PROVIDER=gemini    # gemini | ollama
# --- Storage ---
DATABASE_URL=sqlite:///./organizer.db          # Postgres: postgresql+psycopg2://user:pass@host/db (pip install psycopg2-binary)
CHROMA_DIR=./chroma_store
CORS_ORIGINS=http://localhost:3000
USD_INR=84
